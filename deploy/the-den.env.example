# Installed to /etc/the-den/the-den.env by the package. Copy from the .example
# if it's missing, then edit and `systemctl restart the-den`.

DATABASE_URL=sqlite:////var/lib/the-den/den.db

# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Point these at your real media storage, not the defaults below. Finished downloads are
# hard-linked from DOWNLOADS_ROOT into MOVIES_ROOT/TV_ROOT, so keeping them on the same
# filesystem means imports are instant and take no extra space.
MOVIES_ROOT=/var/lib/the-den/movies
TV_ROOT=/var/lib/the-den/tv

# Built-in torrent client. STATE_DIR holds resume data + DHT state across restarts.
DOWNLOADS_ROOT=/var/lib/the-den/downloads
STATE_DIR=/var/lib/the-den/state
TORRENT_PORT=6881
# KiB/s; 0 = unlimited
DOWNLOAD_RATE_LIMIT_KIB=0
UPLOAD_RATE_LIMIT_KIB=0
# Stop seeding (and delete the downloaded copy) once either is reached; 0 = no limit
SEED_RATIO_LIMIT=2.0
SEED_TIME_LIMIT_MINUTES=0

AUTOMATION_INTERVAL_SECONDS=900

# Optional: Discord channel > Integrations > Webhooks > New Webhook URL.
DISCORD_WEBHOOK_URL=
