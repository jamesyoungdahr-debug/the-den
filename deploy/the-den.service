[Unit]
Description=The Den
After=network.target

[Service]
Type=simple
User=the-den
Group=the-den
WorkingDirectory=/opt/the-den
EnvironmentFile=-/etc/the-den/the-den.env
ExecStart=/opt/the-den/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8686
Restart=on-failure

[Install]
WantedBy=multi-user.target
