[Unit]
Description=The Den
After=network.target

[Service]
Type=simple
User=the-den
Group=the-den
WorkingDirectory=/opt/the-den
EnvironmentFile=-/etc/the-den/the-den.env
# app/__main__.py listens on WEB_HOST:WEB_PORT from the env file (127.0.0.1:40204 by default).
ExecStart=/opt/the-den/.venv/bin/python -m app
Restart=on-failure

[Install]
WantedBy=multi-user.target
