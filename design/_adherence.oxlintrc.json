{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/Button/**",
              "components/Lockup/**",
              "components/MediaTile/**",
              "components/OtterMark/**",
              "components/Panel/**",
              "components/PoolMeter/**",
              "components/ProgressRow/**",
              "components/RingMark/**",
              "components/SelectRow/**",
              "components/ServiceIcon/**",
              "components/StatusPill/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Nunito|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Nunito, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet|onCurrent)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet' | 'onCurrent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute > JSXIdentifier[name!=/^(?:mark|orientation|size|tagline|color|markColor|style|key|ref|className|style|children)$/]",
        "message": "<Lockup> doesn't accept that prop. Declared props: mark, orientation, size, tagline, color, markColor, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute[name.name='mark'] > Literal[value!=/^(?:otter|ring)$/]",
        "message": "<Lockup> mark must be one of 'otter' | 'ring'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Lockup'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|stacked)$/]",
        "message": "<Lockup> orientation must be one of 'horizontal' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|width|ratio|tone|art|style|key|ref|className|style|children)$/]",
        "message": "<MediaTile> doesn't accept that prop. Declared props: title, meta, width, ratio, tone, art, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:current|healthy)$/]",
        "message": "<MediaTile> tone must be one of 'current' | 'healthy'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OtterMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|expression|style|key|ref|className|style|children)$/]",
        "message": "<OtterMark> doesn't accept that prop. Declared props: size, expression, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OtterMark'] > JSXAttribute[name.name='expression'] > Literal[value!=/^(?:happy|idle|alert)$/]",
        "message": "<OtterMark> expression must be one of 'happy' | 'idle' | 'alert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|meta|tone|padding|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children, title, meta, tone, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:surface|deep|raised)$/]",
        "message": "<Panel> tone must be one of 'surface' | 'deep' | 'raised'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PoolMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:percent|size|tone|lines|style|key|ref|className|style|children)$/]",
        "message": "<PoolMeter> doesn't accept that prop. Declared props: percent, size, tone, lines, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PoolMeter'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:healthy|warning|idle)$/]",
        "message": "<PoolMeter> tone must be one of 'healthy' | 'warning' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|percent|meta|tone|style|key|ref|className|style|children)$/]",
        "message": "<ProgressRow> doesn't accept that prop. Declared props: label, percent, meta, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:current|healthy|warning)$/]",
        "message": "<ProgressRow> tone must be one of 'current' | 'healthy' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RingMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|filled|style|key|ref|className|style|children)$/]",
        "message": "<RingMark> doesn't accept that prop. Declared props: size, color, filled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|status|selected|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SelectRow> doesn't accept that prop. Declared props: title, meta, status, selected, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:service|size|label|style|key|ref|className|style|children)$/]",
        "message": "<ServiceIcon> doesn't accept that prop. Declared props: service, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceIcon'] > JSXAttribute[name.name='service'] > Literal[value!=/^(?:plex|sonarr|radarr|prowlarr|qbit|zfs|podman|plasma)$/]",
        "message": "<ServiceIcon> service must be one of 'plex' | 'sonarr' | 'radarr' | 'prowlarr' | 'qbit' | 'zfs' | 'podman' | 'plasma'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|solid|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: children, tone, solid, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:healthy|working|warning|idle)$/]",
        "message": "<StatusPill> tone must be one of 'healthy' | 'working' | 'warning' | 'idle'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Button": {
        "replaces": []
      },
      "Lockup": {
        "replaces": []
      },
      "MediaTile": {
        "replaces": []
      },
      "OtterMark": {
        "replaces": []
      },
      "Panel": {
        "replaces": []
      },
      "PoolMeter": {
        "replaces": []
      },
      "ProgressRow": {
        "replaces": []
      },
      "RingMark": {
        "replaces": []
      },
      "SelectRow": {
        "replaces": []
      },
      "ServiceIcon": {
        "replaces": []
      },
      "StatusPill": {
        "replaces": []
      }
    },
    "tokens": [
      "--holt-current",
      "--holt-current-deep",
      "--holt-deep",
      "--holt-font-core",
      "--holt-font-mono",
      "--holt-hairline",
      "--holt-hairline-strong",
      "--holt-healthy",
      "--holt-ink",
      "--holt-ink-28",
      "--holt-ink-42",
      "--holt-ink-55",
      "--holt-ink-70",
      "--holt-lilac",
      "--holt-radius-lg",
      "--holt-radius-md",
      "--holt-radius-pill",
      "--holt-radius-sm",
      "--holt-raised",
      "--holt-shadow",
      "--holt-space-1",
      "--holt-space-2",
      "--holt-space-3",
      "--holt-space-4",
      "--holt-space-5",
      "--holt-space-6",
      "--holt-surface",
      "--holt-warning"
    ],
    "tokenKinds": {
      "--holt-deep": "color",
      "--holt-surface": "color",
      "--holt-raised": "color",
      "--holt-hairline": "color",
      "--holt-hairline-strong": "color",
      "--holt-ink": "color",
      "--holt-ink-70": "color",
      "--holt-ink-55": "color",
      "--holt-ink-42": "color",
      "--holt-ink-28": "color",
      "--holt-current": "color",
      "--holt-current-deep": "color",
      "--holt-lilac": "color",
      "--holt-healthy": "color",
      "--holt-warning": "color",
      "--holt-font-core": "font",
      "--holt-font-mono": "font",
      "--holt-radius-sm": "radius",
      "--holt-radius-md": "radius",
      "--holt-radius-lg": "radius",
      "--holt-radius-pill": "radius",
      "--holt-shadow": "shadow",
      "--holt-space-1": "spacing",
      "--holt-space-2": "spacing",
      "--holt-space-3": "spacing",
      "--holt-space-4": "spacing",
      "--holt-space-5": "spacing",
      "--holt-space-6": "spacing"
    },
    "fontFamilies": [
      "JetBrains Mono",
      "Nunito"
    ]
  }
}