  "ambient": {
    "glowCurrent": "rgba(177,77,255,.18)",
    "glowHealthy": "rgba(40,224,200,.07)",
    "ring": "rgba(244,235,255,.05)",
    "scrimStrong": "rgba(13,11,18,.92)",
    "scrimMid": "rgba(13,11,18,.62)",
    "scrimWeak": "rgba(13,11,18,.12)",
    "stripe": "rgba(177,77,255,.24)"
  },

  "badge": {
    "available": "#28E0C8",
    "pending": "#B14DFF",
    "processing": "#B14DFF",
    "partial": "#FFB84D",
    "error": "#FFB84D",
    "missing": "rgba(255,255,255,.42)",
    "missingDot": "rgba(255,255,255,.28)"
  },

  "font": {
    "core": "'Nunito',system-ui,-apple-system,sans-serif",
    "mono": "'JetBrains Mono',ui-monospace,SFMono-Regular,monospace",
    "googleFonts": "https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap",
    "coreFamily": "Nunito",
    "monoFamily": "JetBrains Mono"
  },

  "type": {
    "display": { "size": 42, "weight": 900, "tracking": -1.8, "lineHeight": 0.98 },
    "displayHero": { "size": 64, "weight": 900, "tracking": -2.6, "lineHeight": 0.95 },
    "pageTitle": { "size": 26, "weight": 800, "tracking": -1.2, "lineHeight": 1.05 },
    "sectionTitle": { "size": 16, "weight": 800, "tracking": -0.4, "lineHeight": 1.2 },
    "wordmark": { "size": 20, "weight": 900, "tracking": -0.6, "lineHeight": 1 },
    "body": { "size": 15, "weight": 400, "tracking": 0, "lineHeight": 1.6 },
    "bodySmall": { "size": 13, "weight": 400, "tracking": 0, "lineHeight": 1.55 },
    "label": { "size": 13.5, "weight": 700, "tracking": 0, "lineHeight": 1.2 },
    "button": { "size": 12.5, "weight": 800, "tracking": -0.2, "lineHeight": 1 },
    "eyebrow": { "size": 10.5, "weight": 400, "tracking": 2.2, "lineHeight": 1.2, "mono": true, "uppercase": true },
    "meta": { "size": 10.5, "weight": 400, "tracking": 0, "lineHeight": 1.7, "mono": true },
    "fieldLabel": { "size": 10.5, "weight": 400, "tracking": 1.2, "lineHeight": 1.2, "mono": true, "uppercase": true }
  },

  "radius": { "sm": 8, "md": 10, "lg": 14, "pill": 999 },

  "space": { "1": 6, "2": 10, "3": 16, "4": 22, "5": 32, "6": 48 },

  "size": {
    "sidebar": 240,
    "sidebarRail": 72,
    "topBar": 60,
    "tabBar": 72,
    "contentMax": 1400,
    "posterSm": 112,
    "posterMd": 132,
    "posterLg": 148,
    "posterXl": 220,
    "avatar": 28,
    "hitTarget": 44,
    "mobileBreakpoint": 900
