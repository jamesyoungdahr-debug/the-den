  "shadow": {
    "1": "0 2px 14px rgba(0,0,0,.28)",
    "2": "0 8px 24px rgba(0,0,0,.35)",
    "3": "0 24px 60px rgba(0,0,0,.50)"
  },

  "motion": {
    "fast": "160ms",
    "base": "220ms",
    "draw": "1600ms",
    "easeOut": "cubic-bezier(.2,.8,.2,1)"
  }
}
