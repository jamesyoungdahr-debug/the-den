{
  "name": "HoltOS",
  "version": 2,
  "notes": "Single source of truth for HoltOS design tokens. Edit this file, then run `python design/build_tokens.py` to regenerate app/static/holt-tokens.css and the exports under design/exports/ for the KDE and Android clients. Never hand-edit the generated files.",

  "color": {
    "deep": "#0D0B12",
    "surface": "#171423",
    "raised": "#1D1927",
    "hairline": "rgba(255,255,255,.09)",
    "hairlineStrong": "rgba(255,255,255,.15)",
    "ink": "#FFFFFF",
    "ink70": "rgba(255,255,255,.70)",
    "ink55": "rgba(255,255,255,.55)",
    "ink42": "rgba(255,255,255,.42)",
    "ink28": "rgba(255,255,255,.28)",
    "current": "#B14DFF",
    "currentHover": "#C77DFF",
    "currentDeep": "#8F2FE0",
    "currentTint": "rgba(177,77,255,.10)",
    "lilac": "#F4EBFF",
    "healthy": "#28E0C8",
    "warning": "#FFB84D"
  },

  "glass": {
    "surface": "rgba(23,20,35,.70)",
    "surfaceStrong": "rgba(23,20,35,.84)",
    "border": "rgba(255,255,255,.09)",
    "borderStrong": "rgba(255,255,255,.15)",
    "highlight": "rgba(255,255,255,.06)",
    "highlightStrong": "rgba(255,255,255,.08)",
    "blur": "18px",
    "blurStrong": "28px",
    "blurBadge": "8px",
    "saturate": "140%",
    "badgeSurface": "rgba(13,11,18,.72)",
    "inputSurface": "rgba(13,11,18,.50)"
