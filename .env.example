# Copy to .env (or export these) and fill in for real use.
# Movies use TMDB - free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# TV uses TVmaze - free, no key or account needed, nothing to set here.

# Where finished movies/episodes get hard-linked into (copied if on another filesystem)
MOVIES_ROOT=./library/movies
TV_ROOT=./library/tv

# Built-in torrent client. STATE_DIR keeps resume data + DHT state across restarts.
DOWNLOADS_ROOT=./downloads
STATE_DIR=./state
TORRENT_PORT=6881
# KiB/s; 0 = unlimited
DOWNLOAD_RATE_LIMIT_KIB=0
UPLOAD_RATE_LIMIT_KIB=0
# Stop seeding (and delete the downloaded copy) once either is reached; 0 = no limit
SEED_RATIO_LIMIT=2.0
SEED_TIME_LIMIT_MINUTES=0

# How often (seconds) the background job checks downloads and searches for missing items
AUTOMATION_INTERVAL_SECONDS=900

# Optional: a Discord channel's Integrations > Webhooks > New Webhook URL. Leave blank to disable.
DISCORD_WEBHOOK_URL=

# Accounts. false = sign-in optional, everything open as before (default until the desktop/
# Android apps have a login step). true = every page and API call needs a signed-in user;
# first run shows /setup to create the admin. SESSION_SECRET signs the session cookie; blank
# = generated once under STATE_DIR.
AUTH_REQUIRED=false
SESSION_SECRET=

# Plex (optional here -- normally connected from Settings, which stores the owner token).
# PLEX_TV_URL/PLEX_AUTH_URL only change when pointing at tests/mock_plex.py.
PLEX_TOKEN=
PLEX_URL=
