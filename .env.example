# Copy to .env (or export these) and fill in for real use.
# Free key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Your qBittorrent WebUI (Tools > Options > Web UI in the qBittorrent app)
QBIT_URL=http://127.0.0.1:8080
QBIT_USERNAME=admin
QBIT_PASSWORD=adminadmin

# Where finished movies get moved into
MOVIES_ROOT=./library/movies
